# FitPal backend environment variables.
# Copy this file to .env for local development. Never commit .env.
# In production, set these in the Render dashboard instead.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (Render: 1, local: 0).
TRUST_PROXY_HOPS=0

# Rate limit for /api/v1: max requests per window, per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Supabase project (Dashboard -> Project Settings -> API Keys). Publishable key only;
# the API never needs the secret/service-role key for normal requests.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
