# FitPal frontend environment variables.
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Everything here is embedded into the browser bundle at build time, so ONLY
# browser-safe values belong in this file. Never put a Supabase secret /
# service-role key or a database password here.

# Base URL of the Express backend (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase project URL and PUBLISHABLE (public) key — added in Phase 4.
# Find them in Supabase Dashboard -> Project Settings -> API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
