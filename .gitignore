# Root-level ignores. frontend/ and backend/ have their own .gitignore files too.

# Secrets — never commit real environment files
.env
.env.*
!.env.example
*.pem

# Dependencies and build output
node_modules/
dist/
out/
.next/
coverage/

# OS / editor
.DS_Store
Thumbs.db
*.log

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
