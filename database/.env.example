# Used ONLY by `npm run migrate` on your own machine. Never commit database/.env.
#
# Supabase Dashboard -> your project -> "Connect" button -> "Session pooler"
# (IPv4-compatible). Replace [YOUR-PASSWORD] with your database password.
# If the password contains special characters (@ : / ? # %), URL-encode them.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Supabase's CA certificate, used to verify the TLS connection.
# Supabase Dashboard -> Database -> Settings -> SSL Configuration -> "Download certificate"
# Save it as database/certs/supabase-ca.crt
DATABASE_SSL_CA_PATH=./certs/supabase-ca.crt
